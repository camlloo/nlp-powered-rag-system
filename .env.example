APP_NAME=Traditional NLP RAG
APP_ENV=development
API_PREFIX=/api/v1
# Reserved configuration for future development tools; not implemented yet.
ENABLE_LOCAL_TOOLS=true
HOST=127.0.0.1
PORT=8000

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nlp_rag
MYSQL_USER=rag_app
MYSQL_PASSWORD=

# Fill both values only when enabling real model calls.
MODEL_BASE_URL=
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
CHAT_MODEL=qwen3.8-flash
MODEL_TIMEOUT_SECONDS=30
VECTOR_BACKEND=application_exact

CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_CHARS=100
MAX_UPLOAD_BYTES=20971520

