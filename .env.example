APP_NAME=Traditional NLP RAG
APP_ENV=development
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL：按实际环境填写（示例为 WSL docker 容器 pgvector，端口 5433->5432）
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=nlp_rag
PG_USER=postgres
PG_PASSWORD=postgres

# 首期静态 API Token；后期替换为 JWT RBAC
API_TOKEN=change-me
DEFAULT_TENANT_ID=1
DEFAULT_USER_ID=1
# Vue 前端联调预留，逗号分隔
CORS_ORIGINS=http://localhost:5173

# Fill both values only when enabling real model calls.
MODEL_BASE_URL=
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
CHAT_MODEL=qwen3.8-flash
MODEL_TIMEOUT_SECONDS=30
VECTOR_BACKEND=application_exact

CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_CHARS=100
MAX_UPLOAD_BYTES=20971520
