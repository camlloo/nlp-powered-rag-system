APP_NAME=Traditional NLP RAG
APP_ENV=development
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# PostgreSQL：按实际环境填写（示例为 WSL docker 容器 pgvector，端口 5433->5432）
PG_HOST=127.0.0.1
PG_PORT=5433
PG_DATABASE=nlp_rag
PG_USER=postgres
PG_PASSWORD=postgres

# 首期静态 API Token；后期替换为 JWT RBAC
API_TOKEN=change-me
DEFAULT_TENANT_ID=1
DEFAULT_USER_ID=1
# Vue 前端联调预留，逗号分隔
CORS_ORIGINS=http://localhost:5173

# Fill both values only when enabling real model calls.
MODEL_BASE_URL=
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
CHAT_MODEL=qwen3.8-flash
MODEL_TIMEOUT_SECONDS=30
VECTOR_BACKEND=application_exact
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8
EMBEDDING_INPUT_MAX_BYTES=16384
MODEL_DAILY_TOKEN_BUDGET=1000000
MODEL_PER_FILE_TOKEN_BUDGET=100000
CHAT_MAX_OUTPUT_TOKENS=1200
VECTOR_CACHE_MAX_ENTRIES=10000
# MinIO API 地址（不是控制台）；密钥通过安全渠道单独配置。
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=nlprag
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_SECURE=false
# 迁移期间保留旧配置字段；对象存储不读取本地目录。
STORAGE_DIR=data
WORKER_LEASE_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=2
INDEX_CACHE_BUDGET_MB=256
BM25_K1=1.5
BM25_B=0.75
CHANNEL_TOP_K=50
RERANK_TOP_K=30
MMR_LAMBDA=0.75
EVIDENCE_MAX_BLOCKS=6
EVIDENCE_GATE_COSINE_FLOOR=0.2
RETRIEVAL_QUESTION_MAX_CHARS=2000
HISTORY_MAX_ROUNDS=3
CONTEXT_EVIDENCE_BUDGET_TOKENS=6000
CONTEXT_HISTORY_BUDGET_TOKENS=1500
CLEANUP_RETENTION_HOURS=24

CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_CHARS=100
CHUNK_HARD_MAX_CHARS=1000
CHUNK_MIN_CHARS=120
EMBEDDING_TITLE_PREFIX_CHARS=100
MAX_UPLOAD_BYTES=20971520
FALLBACK_ENCODING=gb18030
MAX_PDF_PAGES=300
PDF_MIN_READABLE_RATIO=0.7
PDF_MAX_ABNORMAL_RATIO=0.1
PDF_MIN_PAGE_CHARS=20
